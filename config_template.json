{
  "feeder": {
    "drop_zone": "/path/to/DROP_ZONE",
    "raw_manifest_archive": "/path/to/DROP_ZONE/archive",
    "logs_dir": "logs",
    "batch_selection_policy": "FIFO_ALL",
    "on_batch_failure": "abort",
    "file_stability_window_seconds": 5,
    "source_system_code": "ORACLE_FUSION"
  },
  "schema_guard": {
    "auto_migrate_ddl": true,
    "default_column_type": "VARCHAR(4000)",
    "character_set": "UNICODE",
    "target_database": "globalmart_stg",
    "entity_mapping_file": "entity_mapping.csv"
  },
  "orchestrator": {
    "orchestrator_dir": "/path/to/BICC-Orchestrator",
    "config_file": "config.json",
    "landing_zone": "/path/to/LANDING_ZONE",
    "python_executable": "python"
  },
  "teradata": {
    "host": "<TERADATA_HOST>",
    "user": "<TERADATA_USER>",
    "password": "<TERADATA_PASSWORD>",
    "logmech": "TD2"
  }
}
